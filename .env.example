# Publicação permanece sem indexação até confirmar domínio e conteúdo.
SITE_URL=http://localhost:3000
SITE_PUBLISHED=false
# Rascunhos só aparecem localmente, nunca em NODE_ENV=production.
# Contato requer um volume persistente privado, fora de public/ e do repositório.
CONTACT_DB_PATH=
CONTACT_KEY_ID=v1
CONTACT_KEY_V1=
CONTACT_RATE_KEY=
CONTACT_ENABLED=false
# Somente servidor sob proxy confiável que substitui este cabeçalho.
CONTACT_TRUST_PROXY=false
# Notificação opcional: apenas identificador, nunca o conteúdo do contato.
CONTACT_NOTIFY_URL=
CONTACT_NOTIFY_TOKEN=
